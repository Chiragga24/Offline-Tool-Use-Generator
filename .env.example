# Copy this file to `.env` for local secrets/config.
# Do not commit `.env`.
#
# Optional LLM judge/generator configuration.
# The offline deterministic evaluator should work without these values.
#
# Supported KG_MLE_LLM_PROVIDER examples:
# - gemini      -> GOOGLE_API_KEY
# - openai      -> OPENAI_API_KEY
# - anthropic   -> ANTHROPIC_API_KEY
# - deepseek    -> DEEPSEEK_API_KEY
# - qwen        -> DASHSCOPE_API_KEY
# - together    -> TOGETHER_API_KEY
# - huggingface -> HF_TOKEN
# - ollama      -> KG_MLE_LLM_BASE_URL, no API key required
# - lmstudio    -> KG_MLE_LLM_BASE_URL, no API key required
# - vllm        -> KG_MLE_LLM_BASE_URL, no API key required
#
# KG_MLE_LLM_PROVIDER=huggingface
# KG_MLE_LLM_MODEL=google/gemma-4-E2B-it
# KG_MLE_HF_PROVIDER=auto
# KG_MLE_LLM_BASE_URL=
# HF_TOKEN=hf_...
# GOOGLE_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# DEEPSEEK_API_KEY=...
# DASHSCOPE_API_KEY=...
# TOGETHER_API_KEY=...
#
# Optional semantic graph expansion.
# The default graph builder is deterministic and does not require Mem0.
#
# KG_MLE_SEMANTIC_BACKEND=local
# KG_MLE_EMBEDDING_PROVIDER=huggingface
# KG_MLE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# KG_MLE_SEMANTIC_THRESHOLD=0.78
# KG_MLE_SEMANTIC_TOP_K=5
#
# Mem0 LLM provider is only needed for Mem0 initialization.
# Endpoint-card indexing uses infer=False, so Mem0 does not use the LLM to rewrite memories.
# KG_MLE_MEM0_LLM_PROVIDER=gemini
# KG_MLE_MEM0_LLM_MODEL=gemini-2.0-flash-lite-001
# KG_MLE_MEM0_LLM_BASE_URL=
